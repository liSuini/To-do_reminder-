{
  "name": "todo-reminder-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "待办助手桌面壳",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.limw.todoreminder",
    "productName": "待办助手",
    "directories": {
      "output": "../release"
    },
    "files": ["main.js"],
    "extraResources": [
      { "from": "../dist/todo_backend", "to": "backend" },
      { "from": "../frontend/dist", "to": "backend/frontend_dist" }
    ],
    "win": {
      "target": ["portable"]
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
